# Copy a PostgreSQL connection URI from your provider (for example Neon Free).
# Keep sslmode=require (or verify-full with the provider CA) outside local tests.
MINDMESH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Only during a provider change: preserve the current URI above until the copy is verified.
# MINDMESH_NEXT_DATABASE_URL=postgresql+psycopg://NEW_USER:PASSWORD@NEW_HOST/neondb?sslmode=require
# Optional elevated connection used only by `alembic upgrade head` and the SQLite import.
# MINDMESH_MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional existing least-privilege runtime role which migrations should grant access to.
# MINDMESH_APP_DATABASE_ROLE=mindmesh_app
MINDMESH_UPLOAD_DIR=./var/uploads
MINDMESH_MODEL_DIR=./var/models
# Set to true only when the app is served over HTTPS.
MINDMESH_SECURE_COOKIES=false
# Set to the exact browser origin for local development.
MINDMESH_ORIGIN=http://127.0.0.1:5173
# Enable only behind a proxy that replaces, rather than appends, X-Forwarded-For.
MINDMESH_TRUST_PROXY_HEADERS=false
# Exact direct proxy peer IPs only. Proxy must overwrite X-Forwarded-For.
# Uvicorn must run with --no-proxy-headers; the app checks the direct peer itself.
MINDMESH_TRUSTED_PROXY_IPS=127.0.0.1,::1
MINDMESH_DB_POOL_SIZE=5
MINDMESH_DB_MAX_OVERFLOW=5
# Shared database-backed limits. Change only when deployment needs different capacity.
MINDMESH_RATE_REGISTER_PER_HOUR=20
MINDMESH_RATE_LOGIN_IP_PER_MINUTE=10
MINDMESH_RATE_LOGIN_EMAIL_PER_MINUTE=5
MINDMESH_RATE_UPLOAD_PER_MINUTE=10
MINDMESH_RATE_TRAIN_PER_MINUTE=5
MINDMESH_RATE_PREDICT_PER_MINUTE=60
MINDMESH_RATE_BATCH_PREDICT_PER_MINUTE=10
MINDMESH_RATE_ASSISTANT_PER_MINUTE=6

# Production requires HTTPS origin, Secure cookies and PostgreSQL SSL above.
MINDMESH_ENV=development
# Set true only when dist/ exists, to serve the frontend from the API port.
MINDMESH_SERVE_FRONTEND=false
# Optional real assistant. Keep the key server-side; no key means labelled static help.
OPENAI_API_KEY=
MINDMESH_LLM_MODEL=gpt-4.1-mini
# Set ONLY to a disposable database for tests that drop/recreate the mindmesh schema.
# MINDMESH_TEST_POSTGRES_URL=postgresql+psycopg://TEST_USER:PASSWORD@TEST_HOST:5432/test_db?sslmode=require
